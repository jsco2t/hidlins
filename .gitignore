# Cargo
/target/
**/*.rs.bk
/tools/build-policy/rust-warning-fixture/target/

# Generated verification/build output and interpreter caches
/build/
/tools/android-verifier/build/
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
/vendor/ring/core

# Generated tool caches. Keep these global so new native harnesses do not need
# to rediscover the same Gradle, CMake, Dart, CocoaPods, or Xcode exclusions.
**/.gradle/
**/.cxx/
**/.dart_tool/
**/.pub/
**/.swiftpm/
**/DerivedData/
**/Pods/

# Packaged applications, installers, archives, and native debug bundles are
# release outputs, never source. Native libraries and executables are not
# ignored by extension because the audited Rust/Pub vendor trees legitimately
# contain upstream binary fixtures and platform import libraries.
*.apk
*.aab
*.apks
*.ipa
*.app/
*.xcarchive/
*.xcresult/
*.dSYM/
*.dmg
*.pkg
*.AppImage
*.deb
*.rpm
*.msix
*.mobileprovision

# Crash/profiling and transient compiler output outside normal build trees.
core.[0-9]*
*.core
hs_err_pid*.log
*.profraw
*.profdata
*.gcda
*.gcno
*.tmp
*.temp
*.rej

# Repository-local toolchain/download scratch. This may contain complete Git
# checkouts (for example a Flutter SDK) and must never become an embedded repo
# or checked-in dependency.
/.codex-tmp/
/fuzz/target/
/fuzz/artifacts/

# Editor
*.swp
*.swo
*~

# macOS
.DS_Store

# Local state (vault files, registries — never commit secrets)
*.kdbx
*.kdbx.bak
*.keyfile
vaults.toml

# Local config overrides (keep .cargo/config.toml committed; ignore user overrides)
/.cargo/config.toml.local


# ignore the demo database lock file
test-vaults/demo.kdbx.lock

# Flutter app: build outputs are covered by the template's own nested
# .gitignore files (app/.gitignore, app/linux/.gitignore, ...). Only rules with
# no nested equivalent belong here. Generated bindings in app/lib/src/bridge/
# are COMMITTED (codegen output, not ephemeral).
#
# Cargokit build artifacts (inside the Flutter build tree)
app/rust_builder/target/

# Pub vendor cache — per-checkout state only.
#
# `active_roots/` genuinely holds absolute paths (a package_config.json URI),
# so it must not be committed.
#
# `hosted-hashes/` is COMMITTED, deliberately: each file is a bare 64-char
# sha256 matching pubspec.lock, with no paths and no per-checkout state.
# Excluding it made `dart pub get --offline --enforce-lockfile` report a
# content-hash mismatch for EVERY package on every fresh clone and every CI
# run — while still exiting 0 — which is both permanent false-alarm noise and
# the loss of the one lockfile/cache consistency check pub actually performs.
#
# `_temp/` is pub's download staging area; an interrupted `make pub-vendor`
# would otherwise leave archives there to be committed.
app/vendor-pub/active_roots/
app/vendor-pub/_temp/
app/rust_builder/cargokit/build_tool/vendor-pub/active_roots/
app/rust_builder/cargokit/build_tool/vendor-pub/_temp/

# local agent instructions
.agent-context.local.md

# Codex feature workflow runtime state
.ai/workflow/state.json
.ai/workflow/status.md
.ai/workflow/evidence/
app/android/native-artifacts/
tools/android-verifier/.gradle/
tools/android-verifier/app/build/
